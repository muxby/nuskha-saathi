# ==============================================================================
# Nuskha Saathi Backend Configuration (.env)
# Copy to backend/.env (or .env) and fill in your API keys. Never commit .env.
# ==============================================================================

# --- Server & Networking ---
HOST=0.0.0.0
PORT=8000
UVICORN_RELOAD=false
FRONTEND_BASE_URL=http://localhost:3000
PUBLIC_BACKEND_URL=
CORS_ORIGINS=*

# --- Vision OCR (auto order: Gemini -> OpenRouter -> FreeAPI ImgChat) ---
VISION_PRIMARY=auto
# 1) OpenRouter Vision API (supports free & paid multimodal models)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free
OPENROUTER_FALLBACK_MODELS=google/gemma-4-31b-it:free,google/gemma-4-26b-a4b-it:free,inclusionai/ling-3.2-flash:free,openrouter/free
OPENROUTER_AUDIO_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
# 2) Google Gemini Vision API (optional direct key)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- FreeAPI.Pro Integrations (No API key required) ---
FREEAPI_BASE_URL=https://freeapi.pro
FREEAPI_IMGCHAT_ENABLED=true
FREEAPI_TRANSCRIBE_ENABLED=true
MEDSTER_LIVE=true

# --- Clinical Drug Interaction API (Optional; raises openFDA limit to 240 req/min) ---
OPENFDA_API_KEY=
OPENFDA_LIVE=true

# --- Pakistani Urdu Voice TTS/STT ---
# TTS order: Uplift -> Azure -> Google (falls back to browser Urdu speech if unset)
UPLIFT_API_KEY=
UPLIFT_VOICE_ID=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
GOOGLE_TTS_API_KEY=

# --- WhatsApp Reminders & Day-3 Antibiotic Loop (Configure Twilio OR Meta) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# --- Local Persistence & Static Files (Optional; defaults to backend/data & backend/static) ---
NUSKHA_DB_PATH=
NUSKHA_STATIC_DIR=

# --- Private /admin Diagnostics Panel (Optional; >=16 chars enables /admin login) ---
ADMIN_MONITOR_PASSWORD=
