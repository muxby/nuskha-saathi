# Copy to .env and fill in. Never commit .env.
# openFDA raises the free-tier limit to 240 requests/minute.
OPENFDA_API_KEY=
# Gemini Vision. The model only extracts text. It does not make safety decisions.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Urdu voice. Speech comes from freeapi.pro, which needs no key. Set to 0 to
# switch it off; the app then uses the device's own Urdu voice.
FREEAPI_TTS_ENABLED=1
# Voice used until one is picked in the backend panel: uzma, asad, gul or salman.
URDU_TTS_VOICE=uzma
# Optional fallback that speaks with the same voice when freeapi.pro is down.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# Urdu speech-to-text for WhatsApp voice replies (not used yet).
UPLIFT_API_KEY=
# Public PWA origin, used in the dose card QR payload.
FRONTEND_BASE_URL=http://localhost:3000
# Comma-separated browser origins allowed to call the API. Unset allows any origin.
ALLOWED_ORIGINS=
# Scans per client per minute on the vision routes. 0 disables the limit.
SCAN_RATE_LIMIT_PER_MINUTE=30
# Password for the private backend panel at /admin (12+ characters). Never commit the real value.
ADMIN_MONITOR_PASSWORD=
