# Copy to .env and fill in. Never commit .env.
# openFDA raises the free-tier limit to 240 requests/minute.
OPENFDA_API_KEY=
# Gemini Vision. The model only extracts text. It does not make safety decisions.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Urdu voice providers, tried in this order. Leave unused providers blank.
UPLIFT_API_KEY=
UPLIFT_VOICE_ID=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
GOOGLE_TTS_API_KEY=
# Public PWA origin, used in the dose card QR payload.
FRONTEND_BASE_URL=http://localhost:3000
# Comma-separated browser origins allowed to call the API. Unset allows any origin.
ALLOWED_ORIGINS=
